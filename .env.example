# ShipSeal currently does not require client-side environment variables.
# Do not put OpenAI, Anthropic, GitHub, database, or private API keys in the browser.
# Server-side GitHub App variables are for Vercel/API functions only.
#
# Optional public, non-secret legal identity values. Human/operator approval is
# required before paid external launch. These are intentionally browser-visible.
# VITE_SHIPSEAL_PUBLIC_OPERATOR_NAME=
# Set this to the operator-approved, monitored public contact address.
# VITE_SHIPSEAL_PUBLIC_CONTACT_EMAIL=
# VITE_SHIPSEAL_PUBLIC_GOVERNING_LAW=

# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# Use https://YOUR_DOMAIN/api/github-app/oauth-callback
# GITHUB_APP_CALLBACK_URL=
# Optional HTTPS GitHub Enterprise/API base; defaults to https://api.github.com
# GITHUB_API_BASE_URL=
# GITHUB_APP_SLUG=
# GITHUB_APP_INSTALL_URL=
# Optional server-only token for higher-capacity public repository tree/blob indexing.
# Use read-only public-repository access and never prefix with VITE_.
# SHIPSEAL_GITHUB_PUBLIC_TOKEN=

# Optional server-only Repository Intelligence enrichment.
# Keep disabled for deterministic-only operation. Never prefix these with VITE_.
SHIPSEAL_DEEP_INTELLIGENCE_ENABLED=
SHIPSEAL_DEEP_INTELLIGENCE_PROVIDER=
SHIPSEAL_DEEP_INTELLIGENCE_MODEL=
SHIPSEAL_DEEP_INTELLIGENCE_API_KEY=
# Optional OpenAI-compatible HTTPS base URL; defaults to https://api.openai.com/v1
# SHIPSEAL_DEEP_INTELLIGENCE_BASE_URL=
# General Deep Intelligence only. Repository Futures uses the code-owned,
# stage-specific timing contract in productFuturesTiming.ts.
SHIPSEAL_DEEP_INTELLIGENCE_TIMEOUT_MS=
SHIPSEAL_DEEP_INTELLIGENCE_MAX_OUTPUT_TOKENS=
SHIPSEAL_DEEP_INTELLIGENCE_MAX_REQUEST_BYTES=
SHIPSEAL_DEEP_INTELLIGENCE_MAX_RESPONSE_BYTES=
# Required whenever production ShipSeal-funded AI is enabled. Missing or invalid
# production values fail closed. These values are server-only; never use VITE_*.
SHIPSEAL_AI_GLOBAL_PROVIDER_CALL_LIMIT_PER_DAY=
SHIPSEAL_AI_GLOBAL_MAX_IN_FLIGHT=
# Optional bounded abuse-control overrides. Safe defaults apply in development/test.
# SHIPSEAL_AI_MAX_PROVIDER_CALLS_PER_STAGE (default: 4)
# SHIPSEAL_AI_MAX_STAGE_ATTEMPTS (default: 2)
# SHIPSEAL_AI_PROVIDER_PERMIT_TTL_SECONDS (default: 180)
# SHIPSEAL_AI_STAGE_LEASE_TTL_SECONDS (default: 180)
# Optional non-secret deployment label such as preview or production.
# SHIPSEAL_DEEP_INTELLIGENCE_ENVIRONMENT=

# Optional as a product capability; all five values are required together when account sign-in is enabled (server-only).
# Canonical Production value: https://www.getshipseal.com
SHIPSEAL_APP_ORIGIN=
# PostgreSQL connection string. Never prefix with VITE_.
DATABASE_URL=
# Dedicated GitHub OAuth App credentials for ShipSeal account identity.
SHIPSEAL_ACCOUNT_GITHUB_CLIENT_ID=
SHIPSEAL_ACCOUNT_GITHUB_CLIENT_SECRET=
# Production: https://www.getshipseal.com/api/account/callback
SHIPSEAL_ACCOUNT_GITHUB_CALLBACK_URL=

# Server-only Stripe Billing. Configure Test Mode first and never use VITE_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPSEAL_STRIPE_PRO_PRICE_ID=
# Optional; defaults to 10 Deep Analyses per Stripe billing period.
# SHIPSEAL_PRO_DEEP_ANALYSIS_LIMIT=
